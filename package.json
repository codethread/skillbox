{
	"name": "skillbox",
	"private": true,
	"bin": {
		"skillbox": "./src/cli.ts"
	},
	"type": "module",
	"scripts": {
		"skillbox": "bun run src/cli.ts",
		"build": "bun build src/cli.ts --compile --outfile dist/skillbox",
		"test": "bun test",
		"lint": "oxlint src tests",
		"typecheck": "tsc --noEmit",
		"check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test",
		"fmt": "oxfmt --disable-nested-config",
		"fmt:check": "oxfmt --disable-nested-config --check",
		"prepare": "husky"
	},
	"dependencies": {
		"@clack/prompts": "^1.2.0",
		"@vercel/detect-agent": "^1.2.1",
		"commander": "^15.1.0",
		"picocolors": "^1.1.1",
		"simple-git": "^3.36.0",
		"skills": "github:vercel-labs/skills#4a351bc302b856b58fa13a055e764d3a384b741d",
		"ts-pattern": "^5.9.2",
		"xdg-basedir": "^5.1.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"oxfmt": "0.78.0",
		"oxlint": "^1.93.0",
		"typescript": "^7.0.2"
	},
	"lint-staged": {
		"*": "oxfmt --no-error-on-unmatched-pattern"
	},
	"packageManager": "bun@1.4.2"
}
