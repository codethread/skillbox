{
	"name": "skillbox-lake",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "oxlint --deny-warnings .",
		"fmt": "oxfmt --disable-nested-config",
		"fmt:check": "oxfmt --disable-nested-config --check",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"check": "bun run fmt:check && bun run lint && bun run typecheck"
	},
	"dependencies": {
		"@botlake/core": "0.4.0",
		"@botlake/extension-agents": "0.4.0",
		"@botlake/extension-batteries": "0.4.0",
		"@botlake/extension-ct-config": "0.4.0",
		"@botlake/extension-flags": "0.4.0",
		"@botlake/extension-identity": "0.4.0",
		"@botlake/extension-mail": "0.4.0",
		"@botlake/extension-mail-agents": "0.4.0",
		"@botlake/extension-mail-identity": "0.4.0",
		"@botlake/extension-references": "0.4.0",
		"@botlake/extension-work": "0.4.0",
		"@botlake/extension-work-agents": "0.4.0",
		"@botlake/native-session": "0.4.0"
	}
}
