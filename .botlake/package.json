{
	"name": "skillbox-lake",
	"private": true,
	"type": "module",
	"dependencies": {
		"@botlake/core": "latest",
		"@botlake/extension-agents": "latest",
		"@botlake/extension-batteries": "latest",
		"@botlake/extension-flags": "latest",
		"@botlake/extension-identity": "latest",
		"@botlake/extension-references": "latest",
		"@botlake/extension-work": "latest",
		"@botlake/extension-work-agents": "latest",
		"@botlake/native-session": "latest",
		"ct-config": "file:../../botlake/dist/private/ct-config-0.1.1.tgz"
	},
	"botlake": {
		"name": "skillbox",
		"extensions": [
			"@botlake/extension-batteries",
			"@botlake/extension-identity",
			"./.botlake/src/flags.ts",
			"./.botlake/src/references.ts",
			"./.botlake/src/agents.ts",
			"./.botlake/src/priming.ts",
			"./.botlake/src/work.ts",
			"./.botlake/src/work-agents.ts"
		],
		"minimumCore": "0.2.0"
